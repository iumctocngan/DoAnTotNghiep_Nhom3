# Sao chép file này thành .env rồi điền các giá trị thật
# cp .env.example .env

# ===================== DATABASE =====================
# Connection string SQL Server (cùng DB với .NET backend)
# Dạng pyodbc: DRIVER={ODBC Driver 17 for SQL Server};SERVER=.;DATABASE=CmsEduDb;Trusted_Connection=Yes;
DB_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=.\SQLEXPRESS;DATABASE=CmsEduDb;Trusted_Connection=Yes;TrustServerCertificate=Yes;

# ===================== LLM (Tuần 3) =====================
# Google Gemini (khuyến nghị)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (dự phòng)
OPENAI_API_KEY=your_openai_api_key_here

# Chọn provider: "gemini" hoặc "openai"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# ===================== ML (Tuần 2) =====================
# Đường dẫn file model .joblib đã train
ML_MODEL_PATH=./ai_service/ml_models/renewal_model.joblib
ML_MODEL_VERSION=v1.0.0-lgbm

# ===================== APP =====================
DEBUG=true
LOG_LEVEL=INFO
